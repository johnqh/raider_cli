    "fixtures:capture": "bun run scripts/captureFixture.ts"
  },
  "dependencies": {
    "@sudobility/xray_lib": "^0.0.1",
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3"
