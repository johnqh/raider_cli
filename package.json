{
  "name": "@sudobility/xray_cli",
  "version": "0.0.1",
  "description": "Reconstruct a web app from an xray capture bundle",
  "license": "BUSL-1.1",
  "author": "Sudobility Inc.",
  "homepage": "https://github.com/johnqh/xray_cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnqh/xray_cli.git"
  },
  "bugs": {
    "url": "https://github.com/johnqh/xray_cli/issues"
  },
  "keywords": [
    "xray",
    "reconstruction",
    "cli",
